Bootstrap: docker
From: python:3.12-slim-bookworm

%files
    . /opt/microc-explorer

%post
    apt-get update
    apt-get install -y --no-install-recommends build-essential libcurl4-openssl-dev zlib1g-dev ca-certificates
    cd /opt/microc-explorer
    python -m pip install --no-cache-dir -c constraints.txt '.[contact]'
    rm -rf /var/lib/apt/lists/*
    chmod -R a+rX /opt/microc-explorer

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export MPLCONFIGDIR=/tmp/microc-matplotlib

%runscript
    cd /opt/microc-explorer
    exec microc-web --host 0.0.0.0 "$@"
